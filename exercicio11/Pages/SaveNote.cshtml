@page
@model exercicio11.Pages.SaveNoteModel
@{
}

<div>
    <h2>Salve sua Anotação:</h2>
    <form method="post">
        <label asp-for="Input.Content"></label>
        <input asp-for="Input.Content"/>
        <button type="submit">Salvar</button>
    </form>
    @if(!string.IsNullOrEmpty(Model.FileName))
    {
        <div class="alert alert-sucess mt-3">
            <p>Arquivo <strong>@Model.FileName</strong> foi salvo com sucesso</p>
            <a href="~/files/@Model.FileName" download>Baixar Aqui</a>
        </div>
    }
    <h3>Arquivos salvos:</h3>
    <ul>
        @foreach (var file in Model.Files) 
        {
            <li>
                <a asp-page="/SaveNote" asp-route-file="@file">@file</a>
            </li>
        }
    </ul>
    @if (Model.SelectedContent != null)
    {
        <div class="card p-3 mt-3">
            <h4>Conteúdo do Arquivo:</h4>
            <pre>@Model.SelectedContent</pre>
        </div>
    }

</div>