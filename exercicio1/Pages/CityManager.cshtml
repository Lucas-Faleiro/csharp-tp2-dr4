@page
@model exercicio1.Pages.CityManagerModel
@{
}

<form method="post">
    <div>
        <label asp-for="CityName">Nome</label>
        <input type="text" asp-for="CityName" />
        <button type="submit">Enviar</button>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.CityName))
{
    <div>
        <p>
            Cidade:
            <strong>@Model.CityName</strong>
        </p>
    </div>
}
